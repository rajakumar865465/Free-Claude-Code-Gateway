# Upstream Provider API
BLUESMINDS_API_KEY=your_provider_api_key_here
BLUESMINDS_BASE_URL=https://api.example.com/v1

# Gateway
PORT=8787
DEFAULT_MODEL=gpt-4.1
STRICT_MODEL_MAPPING=false
PROXY_API_KEY=

# Timeout
REQUEST_TIMEOUT_MS=120000

# Security
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_SIZE=20mb
ALLOWED_ORIGINS=

# Admin Dashboard (optional)
# Set ADMIN_PASSWORD to enable HTTP Basic auth for the /admin UI and /admin/api/* endpoints.
# Leave empty to serve the dashboard without authentication (development only).
ADMIN_PASSWORD=

# Logs
DEBUG_LOGS=false

# Startup behaviour
# Set to true to wipe the request log, server.log, and server-err.log on every restart.
# Useful in development so stale error stats don't carry over between sessions.
# Set to false (or leave unset) in production if you want to preserve history across restarts.
CLEAR_LOG_ON_RESTART=false

# Node
NODE_ENV=development

# Persistence
# Request history, config overrides, and model mappings are automatically saved to .blueclaude-data/
# The directory is created on first run and can be deleted to reset all stored data.
